         :deixouCair :O_Queijo ;
         :estaEm :Arvore ;
         :possui :O_Queijo ;
         :sente :S_Confusao ,
                :S_Vaidade ,
                :S_Vergonha ;
         :temCaracteristica :C_Beleza ,
