         :corPlumagem "preto" ;
         :temNome "Corvo 1" ;
         :temTipo "corvo" .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#A_raposa
:A_raposa rdf:type owl:NamedIndividual ,
