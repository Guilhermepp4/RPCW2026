#################################################################

###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#corPlumagem
:corPlumagem rdf:type owl:DatatypeProperty .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#temNome
:temNome rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Local
                                     :Objeto
                                     :Personagem
                                   )
                     ] ;
         rdfs:range xsd:string .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#temTipo
:temTipo rdf:type owl:DatatypeProperty .


