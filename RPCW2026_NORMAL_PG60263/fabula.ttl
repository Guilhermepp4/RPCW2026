               rdfs:range :Local .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#deixouCair
:deixouCair rdf:type owl:ObjectProperty ;
            rdfs:domain :Personagem ;
            rdfs:range :Objeto .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#elogia
:elogia rdf:type owl:ObjectProperty ;
        rdfs:domain :Personagem ;
        rdfs:range :Personagem .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#engana
:engana rdf:type owl:ObjectProperty ;
        rdfs:domain :Personagem ;
        rdfs:range :Personagem .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#estaCom
:estaCom rdf:type owl:ObjectProperty ;
         rdfs:domain :Objeto ;
         rdfs:range :Personagem .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#estaEm
:estaEm rdf:type owl:ObjectProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :Objeto
                                    :Personagem
                                  )
                    ] ;
        rdfs:range :Local .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#possui
:possui rdf:type owl:ObjectProperty ;
        rdfs:domain :Personagem ;
        rdfs:range :Objeto .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#sente
:sente rdf:type owl:ObjectProperty ;
       rdfs:domain :Personagem ;
       rdfs:range :Sentimento .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#temCaracteristica
:temCaracteristica rdf:type owl:ObjectProperty ;
                   rdfs:domain :Personagem ;
                   rdfs:range :Caracteristica .


