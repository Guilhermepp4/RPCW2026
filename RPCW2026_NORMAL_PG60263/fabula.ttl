###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#Animal
:Animal rdf:type owl:Class ;
        rdfs:subClassOf :Personagem .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#Astucia
:Astucia rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( :Caracteristica
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :temTipo ;
                                                      owl:hasValue "Astuto"
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] .


###  http://www.semanticweb.org/guilhermepinho/ontologies/2026/4/untitled-ontology-76#Beleza
:Beleza rdf:type owl:Class ;
