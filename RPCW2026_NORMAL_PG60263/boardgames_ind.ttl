@prefix : <http://www.di.uminho.pt/rpcw2026/PG60263#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.di.uminho.pt/rpcw2026/PG60263> .

<http://www.di.uminho.pt/rpcw2026/PG60263> a owl:Ontology .

#################################################################
#    Classes 
#################################################################

###  Classes Base
:Jogo a owl:Class .
:Autor a owl:Class .
:Editora a owl:Class .
:Mecanica a owl:Class .
:Premio a owl:Class .


#################################################################
#    Object Properties 
#################################################################

###  Relações entre Classes 

:isPublishedBy a owl:ObjectProperty ;
               rdfs:domain :Jogo ;
               rdfs:range :Editora ;
               owl:inverseOf :publishedGame .

:hasMechanic a owl:ObjectProperty ;
             rdfs:domain :Jogo ;
             rdfs:range :Mecanica ;
             owl:inverseOf :usedInGame .
             
:designedGame a owl:ObjectProperty ;
              rdfs:domain :Autor ;
              rdfs:range :Jogo .

:publishedGame a owl:ObjectProperty ;
               rdfs:domain :Editora ;
               rdfs:range :Jogo .

:usedInGame a owl:ObjectProperty ;
            rdfs:domain :Mecanica ;
            rdfs:range :Jogo .

:wonByGame a owl:ObjectProperty ;
           rdfs:domain :Premio ;
           rdfs:range :Jogo .


#################################################################
#    Data Properties
#################################################################

###  Atributos das Classes
:name a owl:DatatypeProperty ;
      rdfs:range xsd:string .

:category a owl:DatatypeProperty ;
          rdfs:domain :Jogo ;
          rdfs:range xsd:string .

:minPlayers a owl:DatatypeProperty ;
            rdfs:domain :Jogo ;
            rdfs:range xsd:integer .

:maxPlayers a owl:DatatypeProperty ;
            rdfs:domain :Jogo ;
            rdfs:range xsd:integer .

:playingTimeMinutes a owl:DatatypeProperty ;
                    rdfs:domain :Jogo ;
                    rdfs:range xsd:integer .

:descriptionEN a owl:DatatypeProperty ;
               rdfs:domain :Jogo ;
               rdfs:range xsd:string .

:country a owl:DatatypeProperty ;
         rdfs:domain :Editora ;
         rdfs:range xsd:string .

:year a owl:DatatypeProperty ;
      rdfs:domain :Premio ;
      rdfs:range xsd:integer .

#################################################################
#    Individuals
#################################################################

###  http://www.di.uminho.pt/rpcw2026/PG60263#catan
:catan a :Jogo ;
      :name "Catan"^^xsd:string ;
      :category "Family"^^xsd:string ;
      :minPlayers 3 ;
      :maxPlayers 4 ;
      :playingTimeMinutes 120 ;
      :descriptionEN "Players take on the roles of settlers, each attempting to build and develop holdings while trading and acquiring resources."^^xsd:string .

