    :ficaEmConcelho :conc_melgaco ;
    :ficaEmFreguesia :freg_castro_laboreiro ;
    :nome "Ponte de Dorna" ;
    :temImagemURL <http://upload.wikimedia.org/wikipedia/commons/thumb/f/f0/Ponte_de_Dorna_1424.jpg/120px-Ponte_de_Dorna_1424.jpg> ;
