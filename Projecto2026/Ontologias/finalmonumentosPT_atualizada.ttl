:Outros a owl:Class ;
    rdfs:subClassOf :Monumento .

:EstruturaMilitar a owl:Class ;
    rdfs:subClassOf :Monumento .

:Concelho a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onClass :Ilha ;
                        owl:onProperty :pertenceIlha ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass :Distrito ;
                        owl:onProperty :pertence_Distrito ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

:SitioArqueologico a owl:Class ;
    rdfs:subClassOf :Monumento .

:EdificioReligioso a owl:Class ;
    rdfs:subClassOf :Monumento .

:Freguesia a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Concelho ;
            owl:onProperty :pertence_concelho ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

:MonumentoCivil a owl:Class ;
    rdfs:subClassOf :Monumento .

