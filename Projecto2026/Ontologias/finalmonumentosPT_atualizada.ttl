    :ficaEmFreguesia :freg_baltar ;
    :nome "Mamoa de Ramos ou Mamoa da Cavada da Oira" ;
    :temDescricao "Procedimento caducado nos termos do artigo 78.º do Decreto-Lei n.º 309/2009, DR, 1.ª série, N.º 206 de 23-10-2009 , alterado pelo Decreto-Lei n.º 265/2012, DR, 1.ª série, n.º 251, de 28-12-2012 Procedimento prorrogado até 31-12-2012 pelo Decreto-Lei n.º 115/2011, DR, 1.ª série, n.º 232, de 5-12-2011 Procedimento prorrogado pelo Despacho n.º 19338/2010, DR, 2.ª série, n.º 252, de 30-12-2010 Despacho de abertura de 15-12-1998"@pt ;
    :temImagemURL <http://www.sem-imagem.com> ;
