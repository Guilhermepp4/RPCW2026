:mon_72188 a :MonumentoCivil ;
    :Ano_Fundacao "2002" ;
    :ficaEmConcelho :conc_covilha ;
    :ficaEmFreguesia :freg_santa_maria_covilha ;
    :nome "Casa dos Ministros ou Casa dos Magistrados" ;
