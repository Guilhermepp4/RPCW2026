:mon_341665 a :MonumentoCivil ;
    :Ano_Fundacao "2002" ;
    :ficaEmConcelho :conc_ponte_de_lima ;
    :ficaEmFreguesia :freg_feitosa ;
    :nome "Solar do Espírito Santo" ;
    :temDescricao "Procedimento caducado nos termos do artigo 78.º do Decreto-Lei n.º 309/2009, DR, 1.ª série, N.º 206 de 23-10-2009 , alterado pelo Decreto-Lei n.º 265/2012, DR, 1.ª série, n.º 251, de 28-12-2012 Procedimento prorrogado até 31-12-2012 pelo Decreto-Lei n.º 115/2011, DR, 1.ª série, n.º 232, de 5-12-2011 Procedimento prorrogado pelo Despacho n.º 19338/2010, DR, 2.ª série, n.º 252, de 30-12-2010 Despacho de abertura de 24 -07-2002"@pt ;
