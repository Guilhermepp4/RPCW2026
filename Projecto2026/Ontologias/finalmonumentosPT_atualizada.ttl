    :ficaEmFreguesia :freg_freixo_de_espada_a_cinta ;
    :nome "Igreja Matriz de Freixo de Espada à Cinta ou Igreja de São Miguel de Freixo de Espada à Cinta" ;
    :temImagemURL <http://upload.wikimedia.org/wikipedia/commons/thumb/7/74/Igreja_Matriz_de_Freixo_de_Espada_%C3%A0_Cinta_II.jpg/120px-Igreja_Matriz_de_Freixo_de_Espada_%C3%A0_Cinta_II.jpg> ;
